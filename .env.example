# --- Browser (public) -------------------------------------------------
# Agent IDs printed by `npm run setup:agents`. Safe to expose: the agents are
# public and carry no secrets. Leave blank to run in Simulated mode.
VITE_ELEVENLABS_APPRENTICE_AGENT_ID=
VITE_ELEVENLABS_TUTOR_AGENT_ID=

# --- Server-side only (never shipped to the browser) -------------------
# Used by scripts/setup-agents.ts and scripts/smoke-agents.ts
ELEVENLABS_API_KEY=
# Optional overrides
ELEVENLABS_VOICE_APPRENTICE=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_VOICE_TUTOR=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Falls back through claude-sonnet-4-5 and gemini-2.5-flash if the first is unavailable
APPRENTICE_LLM=claude-sonnet-5
